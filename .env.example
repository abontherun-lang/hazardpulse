# ============================================================
# HazardPulse — Environment Configuration
# ============================================================
# Copy this file to .env and edit as needed:
#   cp .env.example .env
#
# All values below are optional — the app works without a
# .env file using the defaults in docker-compose.yml.
# ============================================================

# ── Server ──────────────────────────────────────────────────
# Port the web UI and API listen on.
PORT=3000

# ── NOAA Contact Info ───────────────────────────────────────
# NOAA recommends identifying your app with a contact email.
# Replace with your email if you plan to run this long-term.
USER_AGENT=(HazardPulse/1.0, your-email@example.com)

# ── CORS (production only) ──────────────────────────────────
# Comma-separated list of allowed origins.
# Leave commented out to allow all origins.
# ALLOWED_ORIGINS=https://yourdomain.com

# ── Home Base Pin ───────────────────────────────────────────
# Override the map pin location. If not set, the server's
# public IP is geolocated automatically (city-level accuracy).
# HOME_LAT=
# HOME_LON=
# HOME_LABEL=

# ── Advanced (you probably don't need to change these) ──────
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgresql://hazardpulse:hazardpulse@db:5432/hazardpulse
# NODE_ENV=production
