# ============================================================
# HazardPulse — Environment Configuration
# ============================================================
# Copy this file to .env and edit as needed:
#   cp .env.example .env
#
# All values below are optional — the app works without a
# .env file using the defaults in docker-compose.yml.
# ============================================================

# ── Server ──────────────────────────────────────────────────
# Port the web UI and API listen on.
PORT=3000

# ── Display window ──────────────────────────────────────────
# The API only serves events whose event_time is within this many hours,
# regardless of how long each source's TTL keeps them cached. Keeps the map
# and time slider focused on recent activity. Active incidents (NIFC fires,
# volcanoes) are stamped at ingestion so they stay visible while ongoing.
# DISPLAY_WINDOW_HOURS=72

# ── NOAA Contact Info ───────────────────────────────────────
# NOAA recommends identifying your app with a contact email.
# Replace with your email if you plan to run this long-term.
USER_AGENT=(HazardPulse/1.0, your-email@example.com)

# ── CORS (production only) ──────────────────────────────────
# Comma-separated list of allowed origins.
# Leave commented out to allow all origins.
# ALLOWED_ORIGINS=https://yourdomain.com

# ── Home Base Pin ───────────────────────────────────────────
# Override the map pin location. If not set, the server's
# public IP is geolocated automatically (city-level accuracy).
# HOME_LAT=
# HOME_LON=
# HOME_LABEL=

# ── Wildfire detection gate (NASA FIRMS) ────────────────────
# VIIRS reports thermal anomalies, not just wildfires. A detection is shown
# only if it's intense enough to be unmistakable, OR corroborated by a nearby
# active NIFC incident. Volcanic hits are routed to the volcano layer instead.
# FIRE_AUTOADMIT_FRP=50            # MW — auto-admit any detection at/above this Fire Radiative Power
# FIRE_CORROBORATE_GEOREF_KM=2     # base radius (VIIRS georeferencing tolerance) for NIFC matching
# FIRE_CORROBORATE_MAX_KM=15       # cap on the size-scaled NIFC corroboration radius
# VOLCANO_SUPPRESS_KM=20           # detections within this radius of an elevated volcano go to the volcano layer

# ── Advanced (you probably don't need to change these) ──────
# DATABASE_URL=postgresql://hazardpulse:hazardpulse@db:5432/hazardpulse
# NODE_ENV=production
